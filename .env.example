# Copy to .env and change the passwords.
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=house_colors
DB_USER=housecolor
DB_PASSWORD=change-me

# Host ports
MYSQL_PORT=3321
PMA_PORT=8080

MAX_UPLOAD_MB=20
TZ=Asia/Bangkok

# Accounts: administrator is always ADM; its password is set here
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=Test*123
# Password for new users and after a reset (they must set their own at first login)
DEFAULT_PASSWORD=Test*123
